# Copy to .env.local (never commit). Used by: npm run sync:r2

R2_ACCOUNT_ID=7a9071e6af08d0a3d36c2678f1e6ea37
R2_BUCKET=driftae
R2_PUBLIC_BASE=https://pub-7deca3383c7c456a973f05394a5584be.r2.dev

# R2 → Manage R2 API Tokens → Create (Object Read only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: catalog on R2 (needs bucket CORS). Default: /products.json in Git.
# VITE_PRODUCTS_URL=https://pub-7deca3383c7c456a973f05394a5584be.r2.dev/products.json

# Optional: after sync, upload products.json to bucket (token needs Write)
# R2_UPLOAD_CATALOG=1

# Trade Me links file — off by default. Enable later: VITE_TRADEME_LINKS=true

# Footer & social
